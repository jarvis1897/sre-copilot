# Pinned tool and chart versions. Included by the root Makefile.
# Bump these deliberately, one at a time, and re-run `make up`.

# kind release that built the node image pinned in infra/kind-config.yaml; bump both together.
KIND_VERSION=v0.33.0

# open-telemetry/opentelemetry-demo chart (app version 3.1.0). Component images follow the
# chart's appVersion, so this pin also pins the demo images.
OTEL_DEMO_CHART_VERSION=0.42.2

# grafana/loki chart (app version 3.6.12).
LOKI_CHART_VERSION=7.3.0

# Host tools installed by infra/bootstrap.sh. kubectl matches the cluster's Kubernetes version.
KUBECTL_VERSION=v1.36.4
HELM_VERSION=v4.3.0
# Ubuntu 24.04 apt package versions (exact). If bootstrap says a pin is gone from the archive,
# Ubuntu shipped an update: pick the new version from `apt-cache madison <pkg>` and bump here.
DOCKER_IO_VERSION=29.1.3-0ubuntu3~24.04.2
MAKE_VERSION=4.3-4.1build2
